# Salin file ini menjadi .env.local lalu isi dengan data dari Aiven
# (Aiven Console -> service MySQL -> Overview -> Connection information)

DB_HOST=mysql-xxxx-nama-project.a.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=isi-password-anda
DB_NAME=defaultdb

# (Opsional) CA certificate Aiven (isi ca.pem). Jika dikosongkan, koneksi tetap SSL
# tetapi tanpa verifikasi sertifikat. Di Vercel, tempel isi ca.pem apa adanya
# (boleh multi-baris) atau ganti baris baru dengan \n.
DB_CA=
